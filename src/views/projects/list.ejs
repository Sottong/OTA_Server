<div class="page-header animate-fade">
    <div>
        <h1 class="page-title">Projects</h1>
        <p style="color: var(--text-secondary);">Manage your ESP32 firmwares and devices</p>
    </div>
    <a href="/projects/create" class="btn btn-primary">
        <i class="fas fa-plus"></i>
        <span>Create Project</span>
    </a>
</div>

<div class="stats-grid animate-fade">
    <% projects.forEach(project => { %>
        <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; min-height: 200px;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                    <h3 style="font-size: 1.25rem;"><%= project.name %></h3>
                    <span class="badge badge-primary"><%= project._count.devices %> units</span>
                </div>
                <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    <%= project.description || 'No description provided.' %>
                </p>
            </div>
            
            <div style="border-top: rgba(255,255,255,0.05) 1px solid; pt: 1rem; mt: 1rem; display: flex; justify-content: space-between; align-items: center; padding-top: 1rem;">
                <div style="font-size: 0.85rem;">
                    <span style="color: var(--text-secondary);">Active: </span>
                    <% if (project.firmwares && project.firmwares.length > 0) { %>
                        <span class="badge badge-success">v<%= project.firmwares[0].version %></span>
                    <% } else { %>
                        <span style="color: var(--accent-danger);">No Release</span>
                    <% } %>
                </div>
                <a href="/projects/<%= project.id %>" class="btn btn-secondary btn-sm" style="padding: 6px 12px; font-size: 0.8rem;">Manage <i class="fas fa-chevron-right"></i></a>
            </div>
        </div>
    <% }) %>
    
    <% if (projects.length === 0) { %>
        <div class="card" style="grid-column: 1 / -1; padding: 4rem; text-align: center;">
            <div style="font-size: 3rem; color: var(--bg-hover); margin-bottom: 1rem;">
                <i class="fas fa-folder-plus"></i>
            </div>
            <h3>No Projects Found</h3>
            <p style="color: var(--text-secondary);">Start by creating your first OTA project.</p>
            <a href="/projects/create" class="btn btn-primary" style="margin-top: 1.5rem;">Create Project</a>
        </div>
    <% } %>
</div>
