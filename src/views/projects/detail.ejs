<div class="page-header animate-fade">
    <div>
        <div class="breadcrumb">
            <a href="/projects" style="color: inherit; text-decoration: none;">Projects</a>
            <span>/</span>
            <span><%= project.name %></span>
        </div>
        <h1 class="page-title"><%= project.name %></h1>
    </div>
    <div style="display: flex; gap: 12px;">
        <button class="btn btn-danger" onclick="confirmDelete()">
            <i class="fas fa-trash"></i>
            <span>Delete Project</span>
        </button>
    </div>
</div>

<div class="stats-grid animate-fade">
    <div class="card stat-card">
        <div class="stat-label">API KEY</div>
        <div class="stat-value" style="font-size: 1.1rem; font-family: monospace; letter-spacing: 1px;">
            <span id="apiKeyDisplay">••••••••••••••••</span>
            <button class="btn btn-sm btn-secondary" onclick="toggleApiKey()" style="padding: 4px 8px; font-size: 0.7rem; margin-left: 8px;">
                <i class="fas fa-eye" id="toggleIcon"></i>
            </button>
        </div>
        <div style="margin-top: 10px;">
            <form action="/projects/<%= project.id %>/regenerate-key" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-sm btn-secondary" style="font-size: 0.75rem;">Regenerate</button>
            </form>
        </div>
    </div>
    <div class="card stat-card">
        <div class="stat-label">Project ID</div>
        <div class="stat-value" style="font-size: 0.95rem; font-family: monospace;"><%= project.id %></div>
        <div class="stat-label" style="margin-top: 4px;">Use this in your X-Project-ID header</div>
    </div>
</div>

<div class="grid animate-fade" style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-top: 1.5rem;">
    <!-- Firmware List -->
    <div class="card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <h3 style="display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-file-code" style="color: var(--accent-primary);"></i>
                Firmware History
            </h3>
            <a href="/projects/<%= project.id %>/firmware/upload" class="btn btn-sm btn-primary">
                <i class="fas fa-upload"></i> Upload
            </a>
        </div>
        
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Version</th>
                        <th>Release Date</th>
                        <th>Size</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% project.firmwares.forEach(fw => { %>
                        <tr>
                            <td><span class="badge badge-primary">v<%= fw.version %></span></td>
                            <td style="font-size: 0.85rem;"><%= new Date(fw.createdAt).toLocaleDateString() %></td>
                            <td style="font-size: 0.85rem;"><%= (fw.fileSize / 1024).toFixed(1) %> KB</td>
                            <td>
                                <% if (fw.isActive) { %>
                                    <span class="badge badge-success">ACTIVE</span>
                                <% } else { %>
                                    <span class="badge badge-secondary">Ready</span>
                                <% } %>
                            </td>
                            <td>
                                <div style="display: flex; gap: 8px;">
                                    <% if (!fw.isActive) { %>
                                        <form action="/projects/<%= project.id %>/firmware/<%= fw.id %>/activate" method="POST">
                                            <button class="btn btn-sm btn-success" style="font-size: 0.7rem; padding: 4px 8px;">Deploy</button>
                                        </form>
                                    <% } %>
                                    <a href="/projects/<%= project.id %>/firmware/<%= fw.id %>" class="btn btn-sm btn-secondary" style="font-size: 0.7rem; padding: 4px 8px;">Detail</a>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (project.firmwares.length === 0) { %>
                        <tr><td colspan="5" style="text-align: center; color: var(--text-secondary);">No firmwares uploaded yet.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Quick Sections -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div class="card">
            <h3 style="margin-bottom: 1rem;"><i class="fas fa-microchip"></i> Unit Stats</h3>
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: var(--text-secondary);">Online</span>
                    <span style="color: var(--accent-success); font-weight: 600;"><%= deviceStats.online %></span>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: var(--text-secondary);">Up to Date</span>
                    <span><%= deviceStats.upToDate %>/<%= deviceStats.total %></span>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px;">
                    <a href="/projects/<%= project.id %>/devices" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; justify-content: center;">View Units</a>
                    <a href="/projects/<%= project.id %>/webhooks" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; justify-content: center;">Webhooks</a>
                </div>
            </div>
        </div>

        <div class="card">
            <h3 style="margin-bottom: 1rem;"><i class="fas fa-shield-alt"></i> MAC Whitelist</h3>
            <form action="/projects/<%= project.id %>/allowed-macs" method="POST" style="margin-bottom: 1rem;">
                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 8px;">
                    <input type="text" name="macAddress" class="form-control" style="padding: 8px;" placeholder="AA:BB:CC:DD:EE:FF" required pattern="^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$">
                    <button type="submit" class="btn btn-primary" style="padding: 8px; justify-content: center;">Add</button>
                </div>
            </form>
            <div style="max-height: 200px; overflow-y: auto;">
                <% project.allowedMacs.forEach(mac => { %>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: rgba(255,255,255,0.05) 1px solid;">
                        <span style="font-family: monospace; font-size: 0.85rem;"><%= mac.macAddress %></span>
                        <form action="/projects/<%= project.id %>/allowed-macs/<%= mac.id %>/delete" method="POST">
                            <button class="btn btn-sm btn-link" style="color: var(--accent-danger); border: none; background: none; opacity: 0.6;"><i class="fas fa-times"></i></button>
                        </form>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleApiKey() {
        const span = document.getElementById('apiKeyDisplay');
        const icon = document.getElementById('toggleIcon');
        const realKey = "<%= project.apiKey %>";
        
        if (span.innerText === '••••••••••••••••') {
            span.innerText = realKey;
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            span.innerText = '••••••••••••••••';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }

    function confirmDelete() {
        if (confirm('Are you sure you want to delete this project? This will remove all firmwares, devices, and logs!')) {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/projects/<%= project.id %>/delete';
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>
