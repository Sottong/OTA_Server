<div class="page-header animate-fade">
    <div>
        <div class="breadcrumb">
            <a href="/projects/<%= firmware.project.id %>" style="color: inherit; text-decoration: none;"><%= firmware.project.name %></a>
            <span>/</span>
            <span>v<%= firmware.version %></span>
        </div>
        <h1 class="page-title">Release Details: v<%= firmware.version %></h1>
    </div>
    <div>
        <form action="/projects/<%= firmware.project.id %>/firmware/<%= firmware.id %>/delete" method="POST" onsubmit="return confirm('Permanently delete this firmware?')">
            <button class="btn btn-danger">
                <i class="fas fa-trash"></i> Delete
            </button>
        </form>
    </div>
</div>

<div class="grid animate-fade" style="display: grid; grid-template-columns: 1fr 2fr; gap: 1.5rem;">
    <!-- Meta Info -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div class="card">
            <h3 style="margin-bottom: 1rem;"><i class="fas fa-info-circle"></i> Info</h3>
            <div style="display: flex; flex-direction: column; gap: 12px; font-size: 0.9rem;">
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: var(--text-secondary);">File Size</span>
                    <span><%= (firmware.fileSize / 1024).toFixed(1) %> KB</span>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: var(--text-secondary);">Uploaded At</span>
                    <span><%= new Date(firmware.createdAt).toLocaleString() %></span>
                </div>
                <div style="display: flex; flex-direction: column; gap: 4px;">
                    <span style="color: var(--text-secondary);">MD5 Checksum</span>
                    <span style="font-family: monospace; background: #1a1d2e; padding: 4px 8px; border-radius: 4px; border: 1px solid var(--border-color); font-size: 0.8rem; word-break: break-all;"><%= firmware.md5Checksum %></span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
                    <span style="color: var(--text-secondary);">Current Status</span>
                    <% if (firmware.isActive) { %>
                        <span class="badge badge-success">ACTIVE PRODUCTION</span>
                    <% } else { %>
                        <span class="badge badge-secondary">INACTIVE</span>
                    <% } %>
                </div>
                <% if (!firmware.isActive) { %>
                    <form action="/projects/<%= firmware.project.id %>/firmware/<%= firmware.id %>/activate" method="POST" style="margin-top: 10px;">
                        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center;">Deploy this version</button>
                    </form>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Details -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div class="card">
            <h3 style="margin-bottom: 1rem;"><i class="fas fa-sticky-note"></i> Release Notes</h3>
            <div style="white-space: pre-wrap; color: var(--text-primary); font-size: 1rem; line-height: 1.6;">
                <%= firmware.releaseNotes || 'No release notes provided.' %>
            </div>
        </div>

        <div class="card">
            <h3 style="margin-bottom: 1rem;"><i class="fas fa-history"></i> Recent Installations</h3>
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>MAC Address</th>
                            <th>Status</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% firmware.updateLogs.forEach(log => { %>
                            <tr>
                                <td style="font-family: monospace; font-size: 0.85rem;"><%= log.device.macAddress %></td>
                                <td>
                                    <span class="badge <%= log.status === 'SUCCESS' ? 'badge-success' : 'badge-danger' %>"><%= log.status %></span>
                                </td>
                                <td style="font-size: 0.8rem; color: var(--text-secondary);"><%= new Date(log.createdAt).toLocaleString() %></td>
                            </tr>
                        <% }) %>
                        <% if (firmware.updateLogs.length === 0) { %>
                            <tr><td colspan="3" style="text-align: center; color: var(--text-secondary);">No installations recorded yet.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
